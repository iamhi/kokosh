OLLAMA_HOST_URL=http://localhost:11434
OLLAMA_MODEL_TOOL_CALLING=llama3.1:8b
OLLAMA_MODEL_SYNTHESIS=llama3.1:8b
OLLAMA_MODEL_SUMMARIZATION=llama3.2:1b
LLM_DEBUG=false

# fetch_url tool — output directory for fetched .md files (absolute or relative to cwd).
# Defaults to scratch/web/ if unset. Must be inside one of the directories listed in permissions.json.
WEB_FETCH_OUTPUT_DIR=scratch/web
# Optional: absolute path to a Chromium executable. If unset, uses the Chromium bundled with puppeteer.
# CHROMIUM_PATH=/usr/bin/chromium-browser
